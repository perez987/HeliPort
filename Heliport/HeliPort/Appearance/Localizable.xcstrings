    "Would you like HeliPort to start automatically when you log in to your Mac?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد أن يبدأ HeliPort تلقائيًا عند تسجيل الدخول إلى جهاز Mac الخاص بك؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete, aby se HeliPort spouštěl automaticky při přihlášení do Macu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du, dass HeliPort automatisch startet, wenn du dich bei deinem Mac anmeldest?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέλετε το HeliPort να ξεκινά αυτόματα όταν συνδέεστε στο Mac σας;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseas que Heliport arranque automáticamente cuando entras en tu Mac?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous que HeliPort démarre automatiquement lorsque vous vous connectez à votre Mac ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda ingin HeliPort mulai secara otomatis saat Anda masuk ke Mac Anda?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi che HeliPort si avvii automaticamente quando accedi al tuo Mac?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 로그인할 때 HeliPort를 자동으로 시작하시겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz, aby HeliPort uruchamiał się automatycznie po zalogowaniu do Maca?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você gostaria que o HeliPort iniciasse automaticamente quando você entrar no seu Mac?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria que o HeliPort iniciasse automaticamente quando inicia sessão no seu Mac?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doriți ca HeliPort să pornească automat când vă autentificați pe Mac?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите, чтобы HeliPort запускался автоматически при входе в ваш Mac?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'inizde oturum açtığınızda HeliPort'un otomatik olarak başlamasını ister misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бажаєте, щоб HeliPort запускався автоматично під час входу на вашому Mac?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có muốn HeliPort tự động khởi động khi bạn đăng nhập vào máy Mac không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你希望在登录 Mac 时自动启动 HeliPort 吗？"
          }
        }
      }
    },
